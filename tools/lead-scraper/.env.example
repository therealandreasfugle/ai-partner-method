# Copy this file to .env and fill in your own values.
# cp .env.example .env
#
# Required: at least one Apify token, so the scraper can pull leads.
# Free key, no card: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: more free Apify accounts, auto-rotated when one runs low on credit.
# APIFY_API_TOKEN_2=
# APIFY_API_TOKEN_3=

# Optional: publish every scrape straight into a live Google Sheet.
# See google-sheet/SETUP.md for how to get this URL.
# SHEETS_WEBHOOK_URL=
# SHEETS_WEBHOOK_TOKEN=

# Optional: send outreach emails with `--email`. See RESEND-SETUP.md.
# RESEND_API_KEY=
# RESEND_FROM=Your Name <you@yourdomain.com>
# RESEND_REPLY_TO=you@yourrealinbox.com
# OUTREACH_VIDEO_LINK=
# OUTREACH_SENDER_NAME=
# OUTREACH_SENDER_PHONE=
# OUTREACH_DAILY_MAX=

# Optional: only needed for the Make.com scripted install (make/SETUP.md).
# MAKE_API_TOKEN=
# MAKE_ZONE=
