# Copy this file to .env and fill in your own keys.
# .env is gitignored — your keys will never be committed.

# --- REQUIRED ---

# Anthropic API key (for Claude analysis of scraped content)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- OPTIONAL ---

# OpenAI API key (only needed if you want Whisper transcription fallback
# for videos / reels that don't have YouTube auto-captions)
# Cost: ~$0.006 per minute of audio (a 10-min video = $0.06)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# Apify API token (only needed for Instagram scraping — YouTube uses
# free yt-dlp and doesn't need this)
# Free tier: $5 of credit/month, more than enough for testing
# Get one at: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxx
