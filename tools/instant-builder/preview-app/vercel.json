{
  "rewrites": [
    { "source": "/((?!configs/|sites/|trades/|assets/|badges/|patterns/|platforms/|sections/|work/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/configs/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
