        "scope": "roundtrip",
        "variables": [
          {
            "name": "demo_link",
            "value": "https://your-demo-site.com"
          },
          {
            "name": "booking_link",
            "value": "https://calendly.com/you/15min"
          },
          {
            "name": "sender_name",
            "value": "Your Name"
          },
          {
            "name": "sender_phone",
            "value": "000-000-0000"
          }
        ]
      },
      "metadata": {
        "designer": {
          "name": "Set the details (edit these)"
        }
      }
    },
